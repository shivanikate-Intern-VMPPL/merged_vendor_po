# =============================================================================
# Mulyam Unified Portal — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Shared Supabase Project ──────────────────────────────────────────────────
# Both the Purchase Orders module and the Vendor Onboarding module share one
# Supabase project. Set BOTH of these to the same project's URL and anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Vendor Onboarding: dedicated Supabase URL ────────────────────────────────
# The Vendor Onboarding module uses its own client (hardcoded in the original
# code to owlzfkqptquibqtvztqp).  Once you migrate VO data into the shared
# project above, set this to the same URL as VITE_SUPABASE_URL and the same
# anon key as VITE_SUPABASE_ANON_KEY.
VITE_VO_SUPABASE_URL=https://owlzfkqptquibqtvztqp.supabase.co
VITE_VO_SUPABASE_ANON_KEY=your_vo_supabase_anon_key_here

# ── Zoho OAuth (shared credentials for both apps) ───────────────────────────
VITE_ZOHO_CLIENT_ID=your_zoho_client_id_here
VITE_ZOHO_REDIRECT_URI=https://your-unified-domain.com
